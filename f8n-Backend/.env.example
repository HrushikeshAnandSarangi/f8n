FLASK_ENV=development
FLASK_APP=wsgi:app
SECRET_KEY=change-me
DATABASE_URL=postgresql://f8n:f8n@localhost:5432/f8n
CORS_ORIGINS=http://localhost:3000

# Binance Testnet (https://testnet.binance.vision) - required for paper-trading order placement.
# No real funds are ever used; if these are left blank the bot simulates the fill instead.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# Sentiment source block - every source below is independently toggleable per agent
# (see the block's config in the builder). RSS news needs nothing and is on by default;
# the others are optional, free upgrades.

# Reddit (https://www.reddit.com/prefs/apps, type "script") - free. Left blank, the
# Reddit source is silently skipped rather than erroring.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=f8n-agent/1.0

# CryptoPanic (https://cryptopanic.com/developers/api/) - free tier, optional.
CRYPTOPANIC_API_KEY=
